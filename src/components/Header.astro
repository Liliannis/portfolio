---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav aria-label="Navegación principal">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}, Inicio`}>Lili <span>QA</span></a>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/#experiencia">Experiencia</HeaderLink>
			<HeaderLink href="/#portafolio">Portafolio</HeaderLink>
			<HeaderLink href="/#explorando">Explorando</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/#contacto">Contacto</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		border-bottom: 1px solid rgba(203, 213, 225, 0.92);
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(14px);
	}

	nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		width: min(1180px, calc(100% - 2rem));
		min-height: 4.75rem;
		margin: 0 auto;
	}

	.brand {
		color: var(--ink);
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand span { color: var(--accent); }

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: auto;
	}

	nav :global(.internal-links a) {
		padding: 0.5rem 0.65rem;
		border-radius: 0.45rem;
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 650;
		text-decoration: none;
		transition: color 160ms ease, background-color 160ms ease;
	}

	nav :global(.internal-links a:hover),
	nav :global(.internal-links a.active) {
		background: var(--surface-tint);
		color: var(--accent-dark);
	}

	@media (max-width: 760px) {
		nav { flex-wrap: wrap; justify-content: center; gap: 0.45rem; padding: 0.7rem 0; }
		.internal-links { justify-content: center; order: 2; width: 100%; margin-left: 0; flex-wrap: wrap; }
		nav :global(.internal-links a) { padding: 0.35rem 0.45rem; font-size: 0.82rem; }
	}
</style>
