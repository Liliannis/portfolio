---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<a class="footer-brand" href="/">Lili <span>QA</span></a>
			<p>QA Analyst y Analista Funcional enfocada en productos claros, confiables y alineados con las necesidades del negocio.</p>
		</div>
		<nav class="footer-column" aria-label="Navegación del pie de página">
			<p class="footer-title">Navegación</p>
			<a href="/#inicio">Inicio</a><a href="/#experiencia">Experiencia</a><a href="/#portafolio">Portafolio</a><a href="/#explorando">Explorando</a><a href="/blog">Blog</a><a href="/#contacto">Contacto</a>
		</nav>
		<div class="footer-social footer-column" aria-label="Canales de contacto">
			<p class="footer-title">Contacto</p>
			<a href={LINKEDIN_URL} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
			<a href={GITHUB_URL} target="_blank" rel="me noopener noreferrer">GitHub</a>
			<a href="mailto:liliquintana001@gmail.com">Email</a>
		</div>
	</div>
	<p class="copyright">© {today.getFullYear()} Liliannis Quintana Galán. Todos los derechos reservados.</p>
</footer>

<style>
	.site-footer { margin-top: 4rem; padding: 3.5rem 1rem 1.5rem; background: #0F172A; color: #CBD5E1; }
	.footer-inner { display: grid; grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(150px, 0.65fr)); gap: clamp(2rem, 5vw, 4.5rem); width: min(1180px, 100%); margin: 0 auto; }
	.footer-brand { color: #fff; font-size: 1.2rem; font-weight: 800; letter-spacing: -0.04em; text-decoration: none; }
	.footer-brand span { color: #93C5FD; }
	.footer-inner p { max-width: 31rem; margin: 0.8rem 0 0; font-size: 0.92rem; line-height: 1.6; }
	.footer-column { display: grid; align-content: start; gap: 0.55rem; }
	.footer-title { margin: 0 0 0.3rem; color: #fff; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
	.site-footer a { color: #CBD5E1; font-size: 0.9rem; text-decoration: none; }
	.site-footer a:hover { color: #60A5FA; }
	.copyright { width: min(1180px, 100%); margin: 2.75rem auto 0; padding-top: 1.25rem; border-top: 1px solid rgba(147, 197, 253, 0.22); color: #94A3B8; font-size: 0.78rem; }
	@media (max-width: 650px) { .footer-inner { grid-template-columns: 1fr 1fr; gap: 2rem; } .footer-inner > :first-child { grid-column: 1 / -1; } }
</style>
