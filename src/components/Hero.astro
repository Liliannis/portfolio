---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<section id="inicio" class="hero" aria-labelledby="inicio-title">
	<div class="hero-copy">
		<p class="eyebrow">QA Analyst · Análisis funcional</p>
		<h1 id="inicio-title">QA para productos confiables y alineados con el negocio.</h1>
		<p class="hero-summary">Soy Liliannis Quintana Galán, Ingeniera en Ciencias Informáticas y QA Analyst. Realizo pruebas funcionales y validación de datos para ayudar a los equipos a entregar productos más confiables.</p>
		<p class="hero-detail">Tengo experiencia acompañando plataformas de Business Intelligence y sistemas corporativos: desde reglas de negocio y casos de prueba hasta APIs, SQL, dashboards y seguimiento de incidencias.</p>
		<div class="hero-actions">
			<a class="button button-primary" href="/liliannis-quintana-galan-cv.pdf" download>Descargar CV</a>
			<a class="button button-secondary" href="#portafolio">Ver mi trabajo</a>
		</div>
		<div class="hero-social" aria-label="Perfiles profesionales">
			<a href={LINKEDIN_URL} target="_blank" rel="me noopener noreferrer">LinkedIn <span aria-hidden="true">?</span></a>
			<a href={GITHUB_URL} target="_blank" rel="me noopener noreferrer">GitHub <span aria-hidden="true">?</span></a>
		</div>
	</div>
	<div class="hero-photo-wrap">
		<p class="location-badge" aria-label="Ubicación actual">Montevideo, Uruguay</p>
		<img src="/perfil-lili.jpeg" alt="Liliannis Quintana Galán" class="profile-img" />
	</div>
</section>

<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.72fr); align-items: center; gap: clamp(2.5rem, 7vw, 6.5rem); padding: clamp(3rem, 8vw, 6.5rem) 0; }
	.hero-copy { max-width: 43rem; }
	.eyebrow { margin: 0 0 1rem; color: var(--accent); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
	.hero h1 { max-width: 12ch; margin-bottom: 1.25rem; font-size: clamp(2.8rem, 6vw, 5.3rem); letter-spacing: -0.065em; }
	.hero-summary { max-width: 39rem; margin-bottom: 1rem; color: #1E293B; font-size: clamp(1.1rem, 2vw, 1.28rem); }
	.hero-detail { max-width: 39rem; color: var(--text); font-size: 1rem; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
	.button { display: inline-flex; justify-content: center; align-items: center; min-height: 2.9rem; padding: 0.65rem 1.1rem; border: 1px solid var(--accent); border-radius: 0.5rem; font-weight: 750; text-decoration: none; transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease; }
	.button:hover { transform: translateY(-2px); text-decoration: none; }
	.button-primary { background: var(--accent); color: #fff; box-shadow: 0 9px 22px rgba(37, 99, 235, 0.24); }
	.button-primary:hover { background: var(--accent-dark); color: #fff; }
	.button-secondary { color: var(--accent-dark); }
	.button-secondary:hover { background: var(--accent-soft); color: var(--accent-dark); }
	.hero-social { display: flex; gap: 1rem; margin-top: 1.35rem; }
	.hero-social a { color: var(--text); font-size: 0.9rem; font-weight: 700; text-decoration: none; }
	.hero-social a:hover { color: var(--accent-dark); }
	.hero-photo-wrap { position: relative; justify-self: end; width: min(100%, 370px); }
	.location-badge { position: absolute; top: 1rem; left: 1rem; z-index: 2; margin: 0; padding: 0.45rem 0.75rem; border: 1px solid rgba(255, 255, 255, 0.72); border-radius: 999px; background: rgba(255, 255, 255, 0.82); color: var(--color-heading); box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14); backdrop-filter: blur(12px); font-size: 0.78rem; font-weight: 750; }
	.profile-img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center top; border-radius: 1.25rem; }
	@media (max-width: 760px) { .hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 3rem; } .hero-photo-wrap { justify-self: start; width: min(78%, 330px); order: -1; } .hero h1 { max-width: 15ch; } }
</style>
