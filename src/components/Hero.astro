---
import { LINKEDIN_URL, GITHUB_URL } from '../consts';
---

<section class="hero animate-fade-in-up">
	<img src="/perfil-lili.jpeg" alt="Foto de perfil de Liliannis" class="profile-img" />
	<p class="eyebrow">QA Engineer · Testing &amp; Automatización</p>
	<h1>Liliannis Quintana Galán</h1>
	<p class="subheadline">
		Convierto requerimientos ambiguos en software confiable. Diseño y ejecuto pruebas
		funcionales, E2E y de regresión, valido APIs con Postman y SQL, y estoy escalando ese
		trabajo con automatización en Playwright y TypeScript.
	</p>

	<div class="skills animate-stagger">
		<span class="skill-badge">SQL</span>
		<span class="skill-badge">APIs REST</span>
		<span class="skill-badge">Postman</span>
		<span class="skill-badge">Playwright</span>
		<span class="skill-badge">TypeScript</span>
		<span class="skill-badge">Agile Scrum</span>
	</div>

	<div class="hero-ctas">
		<a
			class="btn btn-primary"
			href={LINKEDIN_URL}
			target="_blank"
			rel="noopener noreferrer"
		>
			Conectemos en LinkedIn
		</a>
		<a
			class="btn btn-secondary"
			href={GITHUB_URL}
			target="_blank"
			rel="noopener noreferrer"
		>
			Ver GitHub
		</a>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-bottom: 2rem;
	}
	.profile-img {
		width: 150px;
		height: 150px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
		border: 4px solid var(--accent);
		box-shadow: var(--box-shadow);
	}
	.eyebrow {
		margin: 0 0 0.5rem 0;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.9rem;
		font-weight: 700;
	}
	.hero h1 {
		margin-bottom: 0.5rem;
	}
	.subheadline {
		max-width: 42rem;
		color: rgb(var(--gray-dark));
		font-weight: 600;
		font-size: 1.3rem;
		margin-top: 0;
	}
	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin: 1.5rem 0;
	}
	.skill-badge {
		background-color: var(--accent-dark);
		color: white;
		padding: 0.2rem 0.8rem;
		border-radius: 20px;
		font-size: 0.9rem;
	}
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
		margin-top: 0.5rem;
	}
	.btn {
		display: inline-block;
		padding: 0.7rem 1.6rem;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
		border: 2px solid var(--accent);
		transition: opacity 0.2s ease;
	}
	.btn:hover {
		opacity: 0.85;
	}
	.btn-primary {
		background-color: var(--accent);
		color: white;
	}
	.btn-primary:hover {
		color: white;
	}
	.btn-secondary {
		background-color: transparent;
		color: var(--accent);
	}
	.btn-secondary:hover {
		color: var(--accent);
	}
</style>
